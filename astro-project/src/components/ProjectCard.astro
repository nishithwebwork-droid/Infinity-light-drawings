---
interface Props {
  title: string;
  category: string;
  director: string;
  role: string;
  year: string;
  aspect: string;
  image: string;
  logline: string;
}

const { title, category, director, role, year, aspect, image, logline } = Astro.props;
---

<div class="group bg-[#121212] rounded-xl overflow-hidden border border-white/10 hover:border-[#F5A623] transition-all duration-300 flex flex-col justify-between shadow-xl">
  <div>
    <div class="relative aspect-[16/10] overflow-hidden bg-black">
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-85 group-hover:opacity-100"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
      <div class="absolute top-3 left-3 flex items-center gap-2">
        <span class="px-2 py-0.5 text-[9px] font-mono uppercase bg-[#F5A623] text-black font-bold rounded">
          {category}
        </span>
        <span class="px-2 py-0.5 text-[9px] font-mono bg-black/80 text-white rounded border border-white/10">
          {year}
        </span>
      </div>
      <div class="absolute top-3 right-3 text-[9px] font-mono text-[#CCCCCC] bg-black/80 px-2 py-0.5 rounded border border-white/10">
        {aspect}
      </div>
    </div>

    <div class="p-6">
      <div class="text-[11px] font-mono text-[#A0A0A0] mb-1">
        Dir. <span class="text-white">{director}</span> &bull; {role}
      </div>
      <h3 class="text-2xl sm:text-3xl font-bebas tracking-wide text-white group-hover:text-[#F5A623] transition-colors leading-tight mb-2">
        {title}
      </h3>
      <p class="text-xs text-[#A0A0A0] font-light line-clamp-2 leading-relaxed">
        {logline}
      </p>
    </div>
  </div>

  <div class="px-6 py-4 border-t border-white/5 bg-[#0E0E0E] flex items-center justify-between text-xs font-mono text-[#F5A623]">
    <span class="text-[11px]">EXPLORE PRODUCTION</span>
    <span>&rarr;</span>
  </div>
</div>
