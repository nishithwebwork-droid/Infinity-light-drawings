            SUBMIT CO-PRODUCTION PITCH
          </a>
        </div>
      </div>

      <!-- Studio Hubs -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-[#101010] p-6 rounded-lg border border-white/10">
          <span class="text-xs font-mono text-[#F5A623] tracking-widest uppercase block mb-2">
            MUMBAI STUDIO
          </span>
          <p class="text-sm text-white font-medium">
            Next to Billabong High School, Jankalyan Nagar, Malad West, Mumbai - 400095
          </p>
          <div class="text-xs text-[#A0A0A0] font-mono mt-3">
            Tel: +91 98201 48920 &bull; mumbai@infinitydrawings.com
          </div>
        </div>

        <div class="bg-[#101010] p-6 rounded-lg border border-white/10">
          <span class="text-xs font-mono text-[#F5A623] tracking-widest uppercase block mb-2">
            ODISHA PRODUCTION HUB
          </span>
          <p class="text-sm text-white font-medium">
            Plot 142/B, Saheed Nagar, Bhubaneswar, Odisha - 751007
          </p>
          <div class="text-xs text-[#A0A0A0] font-mono mt-3">
            Tel: +91 94370 82110 &bull; odisha@infinitydrawings.com
          </div>
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-[11px] font-mono text-[#666] gap-4">
      <div>
        &copy; {new Date().getFullYear()} INFINITY LIGHT DRAWINGS. Directed by Nishith Sahasransu Ray.
