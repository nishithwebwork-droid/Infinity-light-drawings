<footer class="bg-[#070707] text-white border-t border-white/10 pt-20 pb-12 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <!-- Top CTA -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      <div class="lg:col-span-7">
        <span class="text-xs font-mono text-[#F5A623] tracking-[0.25em] uppercase block mb-3">
          INITIATE COLLABORATION
        </span>
        <h2 class="text-5xl sm:text-6xl md:text-7xl font-bebas tracking-wide text-white mb-6 leading-none">
          WORK WITH US.
        </h2>
        <p class="text-sm sm:text-base text-[#A0A0A0] max-w-xl font-light leading-relaxed mb-8">
          Whether developing a theatrical feature, climate documentary, high-impact commercial TVC, or seeking an experienced co-production unit in India, our lens is ready.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/contact"
            class="px-6 py-3.5 bg-[#F5A623] hover:bg-[#FFAA1D] text-black text-xs font-mono font-bold tracking-widest rounded shadow-[0_0_25px_rgba(245,166,35,0.3)]"
