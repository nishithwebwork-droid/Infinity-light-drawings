---
const items = [
  'FEATURE FILMS',
  'DOCUMENTARIES',
  'COMMERCIALS',
  'AD FILMS',
  'CINEMATIC DEPTH',
  'AWARD WINNING'
];

const repeated = [...items, ...items, ...items, ...items];
---

<div class="relative overflow-hidden bg-[#F5A623] py-4 select-none border-y border-[#F5A623]/30 shadow-[0_0_40px_rgba(245,166,35,0.2)]">
  <div class="flex whitespace-nowrap animate-marquee">
    {repeated.map((text) => (
      <div class="flex items-center mx-6">
        <span class="font-bebas text-3xl sm:text-4xl md:text-5xl text-black tracking-wider font-extrabold uppercase">
          {text}
        </span>
        <span class="ml-8 text-black text-xl sm:text-2xl font-serif">✦</span>
      </div>
    ))}
  </div>
</div>
